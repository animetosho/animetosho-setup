limit_req_zone $limit_ip zone=cacheIp:4m rate=90r/m;
proxy_cache_path /cache/nginx/proxy/ levels=1:2 keys_zone=cachesrv_cache:8m inactive=60m max_size=8m;

server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name {{ cache_hostname }};

	include snippets/ssl.conf;
	ssl_certificate /etc/letsencrypt/live/{{ cache_hostname }}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{ cache_hostname }}/privkey.pem;
	
	
	root /var/www/cache/www;
	index index.jpg index.html;
	include snippets/static.conf;
	
	location ~ ^/nyaasi(-sukebei)?/ {
		limit_req zone=cacheIp burst=10 nodelay;
		
		proxy_connect_timeout 5s;
		proxy_read_timeout 10s;
		proxy_send_timeout 10s;
		proxy_buffers 4 16k;
		proxy_pass http://unix:/var/run/cachesrv/cachesrv.sock:;
		proxy_max_temp_file_size 0;
		
		proxy_cache cachesrv_cache;
		proxy_cache_key "$request_uri";
		proxy_cache_valid 200 404 5m;
		proxy_cache_valid 301 302 400 500 0;
		
		access_log /var/log/nginx/access-cache.log;
		#strip on;
	}
	error_log /var/log/nginx/error-cache.log warn;
}

# redirect
server {
	listen 80;
	listen [::]:80;
	server_name {{ cache_hostname }};
	expires epoch;
	add_header X-Content-Type-Options "nosniff" always;
	location / {
		rewrite ^/(.*) https://{{ cache_hostname }}/$1 permanent;
	}
	
	location ~ ^/.well-known { root /var/www; }
	
	access_log off;
	error_log /var/log/nginx/error-cache.log warn;
}
