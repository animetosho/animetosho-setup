limit_req_log_level warn;
limit_req_status 429;

#client_body_temp_path /cache/nginx/body;
#fastcgi_temp_path /dev/shm/nginx/fastcgi;
#proxy_temp_path /cache/nginx/proxy;

client_max_body_size 192k;
output_buffers 2 64k;

#text/html is always compressed
gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss application/rss+xml application/xml+atom application/atom+xml text/javascript;
brotli on;
brotli_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss application/rss+xml application/xml+atom application/atom+xml text/javascript;
brotli_comp_level 3;
