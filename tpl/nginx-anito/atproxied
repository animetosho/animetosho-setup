#duplicate this because nginx doesn't like variables in proxy_method

location ~* ^/__proxy_updates/GET/([a-zA-Z0-9]+)/([^/]+)/(.*)$ {
  internal;

  proxy_set_header Host $2;
  proxy_method GET;

  # Do not touch local disks when proxying
  # content to clients
  proxy_max_temp_file_size 0;

  proxy_http_version 1.1;
  include snippets/proxy.conf;

  proxy_pass http://unix:/var/run/spiped.nginx-$1.sock:/$3?$args;
  proxy_redirect http://$2/ https://$http_host/admin/;
}
