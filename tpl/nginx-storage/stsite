root /storage/storage;
index index.jpg index.html;

add_header Access-Control-Allow-Origin * always;
add_header Access-Control-Allow-Methods "HEAD, GET, OPTIONS" always;
add_header Access-Control-Max-Age 1209600 always;
add_header Onion-Location "http://{{ storage_onion }}$request_uri" always;

open_file_cache max=1000;
open_file_cache_valid 30s;
output_buffers 2 256k;

location ~ ^/sshots/([a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9])/([^/]+\.jpg)$ {
	file_in_unzip_archivefile $document_root/sshots/$1/$2/$3.zip;
	file_in_unzip_extract $4;
	file_in_unzip;
	
	expires 7d;
	access_log off;
}
location ~ ^/attach/ {
	rewrite ^/attach(ments)?/([a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9][a-f0-9])/([^/]*\.xz)$ /attachments/$2/$3.xz break;
	types {
		application/x-xz xz;
	}
	
	expires 7d;
	access_log off;
}
location ~ ^/(tor)?attachpk/ {
	# block bot sucking up all our bandwidth
	set $uriua "$uri|$http_user_agent";
	if ($uriua ~ "/file\.7z\|Mozilla/5\.0 \(Windows NT 10\.0; rv:109\.0\) Gecko/20100101 Firefox/115\.0$") {
		return 403;
	}
	
	# proxy to xz server
	proxy_connect_timeout 5s;
	proxy_read_timeout 10s;
	proxy_send_timeout 10s;
	proxy_buffering off;
	proxy_buffers 16 64k;
	#proxy_pass http://localhost:8008;
	proxy_pass http://unix:/tmp/xzserv.sock:;
	proxy_max_temp_file_size 0;
}

location ~ ^/torrent/ {
	rewrite ^/torrents?/([a-f0-9][a-f0-9][a-f0-9])([a-f0-9]*)/([^/]*\.torrent)$ /torrents/$1/$2.torrent break;
	types {
		application/x-bittorrent torrent;
	}
	
	expires 7d;
	access_log off;
}

location ~ ^/(anidex|nyaasis?|nekobt)_archive/ {
	rewrite ^/(anidex|nyaasis?)_archive/0*([a-f0-9]+)([a-f0-9][a-f0-9][a-f0-9])/([^/]*\.torrent)$ /$1_archive/$2/$3.torrent break;
	rewrite ^/(nekobt)_archive/0*([a-f0-9]+)([a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9])/([^/]*\.torrent)$ /$1_archive/$2/$3.torrent break;
	types {
		application/x-bittorrent torrent;
	}
	
	expires 7d;
	access_log off;
}


location ~ ^/nzbs/.*\.nzb\.gz$ {
	rewrite ^/nzbs?/([a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9])/([^/]*\.nzb\.gz)$ /nzb/$1/$2/$3.nzb.gz break;
	types {
		application/x-gzip gz;
	}
	expires 7d;
}
location ~ ^/nzbs/.*\.nzb$ {
	# block bot sucking up all our bandwidth
	set $uriua "$uri|$http_user_agent";
	if ($uriua ~ "/file\.nzb|Mozilla/5\.0 \(Windows NT 10.0; rv:109\.0\) Gecko/20100101 Firefox/115\.0$") {
		return 403;
	}
	
	rewrite ^/nzbs?/([a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9])/([^/]*\.nzb)$ /nzb/$1/$2/$3.nzb break;
	gzip_static always;
	gunzip on;
	types {
		application/x-nzb nzb;
	}
	
	expires 7d;
}

location ~ "^/sframes/[0-9a-f]{8}_([0-9]+\.mkv|[0-9]+_[0-9]+\.webp)(\?.*)?$" {
	rewrite ^/sframes/([a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9][a-f0-9])([a-f0-9][a-f0-9])_([0-9]+\.mkv|[0-9]+_[0-9]+\.webp)$ /sframes/$1/$2/$3_$4 break;
	types {
		video/x-matroska mkv;
		image/webp webp;
	}
	expires 7d;
}

location ~ "^/sframes/[0-9a-f]{8}_[0-9]+\.png(\?s=[0-9]+(&x264=[0-9]+)?|\?x264=[0-9]+(&s=[0-9]+)?)?$" {
	include uwsgi_params;
	uwsgi_pass unix:/run/uwsgi/app/framesv/socket;
	limit_req zone=sframeIp;
	limit_req zone=sframeIp2 burst=60 nodelay;
	
	expires 7d;
	
	uwsgi_cache sframes_full_cache;
	uwsgi_cache_min_uses 2;
	uwsgi_cache_key $request_uri;
	uwsgi_cache_valid 200 3d;
	uwsgi_cache_valid 500 15m;
	uwsgi_cache_valid 400 404 403 0;
	uwsgi_cache_use_stale timeout;
	uwsgi_buffers 3 1m;
	uwsgi_max_temp_file_size 0;
	
	uwsgi_ignore_headers X-Accel-Expires;
	uwsgi_pass_request_headers off;
}
location ~ ^/sframes/ {
	include uwsgi_params;
	uwsgi_pass unix:/run/uwsgi/app/framesv/socket;
	limit_req zone=sframeIp;
	limit_req zone=sframeIp2 burst=60 nodelay;
	
	expires 7d;

	uwsgi_cache sframes_cache;
	uwsgi_cache_min_uses 0;
	uwsgi_cache_key $request_uri;
	uwsgi_cache_valid 200 7d;
	uwsgi_cache_valid 500 15m;
	uwsgi_cache_valid 400 404 403 0;
	uwsgi_cache_use_stale timeout;
	uwsgi_buffers 4 32k;
	uwsgi_max_temp_file_size 0;
	
	uwsgi_pass_request_headers off;
}

location ~ ^/adbpics/(50x65|65x100|150|main)/([0-9a-z.\-]+\.(jpe?g|gif|png))$ {
	proxy_pass https://https_adbpics/images/$1/$2;
	proxy_connect_timeout 15s;
	proxy_read_timeout 15s;
	proxy_send_timeout 15s;
	proxy_buffers 16 64k;
	proxy_set_header Host cdn.anidb.net;
	proxy_max_temp_file_size 0;
	proxy_http_version 1.1;
	proxy_set_header Connection "";
	proxy_set_header Referer http://anidb.net/;
	proxy_set_header Cookie "";
	proxy_pass_request_headers off;
	proxy_hide_header X-Frame-Options;
	proxy_hide_header X-XSS-Protection;
	proxy_hide_header X-Content-Type-Options;

	proxy_cache_min_uses 0;
	proxy_cache adbpics_cache;
	proxy_cache_key $request_uri;
	proxy_cache_valid 200 180d;
	proxy_cache_valid 301 302 404 1h;
	proxy_cache_valid 400 500 403 0;
	proxy_ignore_headers Cache-Control X-Accel-Expires Set-Cookie X-Accel-Redirect;
	proxy_cache_use_stale timeout;
}

access_log /var/log/nginx/access-storage.log combined buffer=4k flush=1s;
error_log /var/log/nginx/error-storage.log warn;
